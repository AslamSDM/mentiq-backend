# Analytics Platform Environment Configuration

# Required: S3 bucket name for storing events (Cloudflare R2)
S3_BUCKET_NAME=your-analytics-bucket-name

# Required: Cloudflare R2 credentials
AWS_ACCESS_KEY_ID=your-r2-access-key
AWS_SECRET_ACCESS_KEY=your-r2-secret-key

# Optional: Port number for the server (default: 8080)
PORT=8080

# Optional: Enable CORS debugging (default: false)
CORS_DEBUG=false

# Optional: Database URL for advanced analytics (future feature)
# DATABASE_URL=postgres://user:password@localhost:5432/analytics

# Optional: Redis URL for caching (future feature)  
# REDIS_URL=redis://localhost:6379

# Optional: Enable debug logging
# DEBUG=true

# Stripe API Key
STRIPE_API_KEY=your-stripe-api-key

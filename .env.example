# Analytics Platform Environment Configuration

# Required: S3 bucket name for storing events
S3_BUCKET_NAME=your-analytics-bucket-name

# Required: AWS region where your S3 bucket is located
AWS_REGION=us-east-1

# Optional: Port number for the server (default: 8080)
PORT=8080

# Optional: Enable CORS debugging (default: false)
CORS_DEBUG=false

# AWS Credentials (if not using IAM roles or AWS CLI profile)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: AWS Profile (if using multiple AWS profiles)
# AWS_PROFILE=your-profile-name

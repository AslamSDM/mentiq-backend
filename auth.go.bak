package main

import (
	"context"
	"log"
	"net/http"
	"strings"

	"mentiq-backend/prisma/db"

	"github.com/gin-gonic/gin"
)

// AuthMiddleware validates the API key and project ID.
func AuthMiddleware(dbClient *db.PrismaClient) gin.HandlerFunc {
	return func(c *gin.Context) {
		authHeader := c.GetHeader("Authorization")
		projectID := c.GetHeader("X-Project-ID")

		if authHeader == "" || projectID == "" {
			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "Authorization header and X-Project-ID header are required"})
			return
		}

		apiKeyStr := authHeader
		if strings.HasPrefix(apiKeyStr, "Bearer ") {
			apiKeyStr = strings.TrimPrefix(apiKeyStr, "Bearer ")
		} else if strings.HasPrefix(apiKeyStr, "ApiKey ") {
			apiKeyStr = strings.TrimPrefix(apiKeyStr, "ApiKey ")
		}

		// Find the API key in the database.
		apiKey, err := dbClient.APIKey.FindFirst(
			db.APIKey.Key.Equals(apiKeyStr),
			db.APIKey.IsActive.Equals(true),
		).With(
			db.APIKey.Project.Fetch().With(
				db.Project.Account.Fetch(),
			),
		).Exec(context.Background())

		if err != nil {
			if err == db.ErrNotFound {
				c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "Invalid or inactive API Key"})
				return
			}
			c.AbortWithStatusJSON(http.StatusInternalServerError, gin.H{"error": "Could not verify API key"})
			return
		}

		// Verify the API key is for the correct project.
		if apiKey.ProjectID != projectID {
			c.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": "API Key does not match project ID"})
			return
		}

		// Set account and project info in the context for handlers to use.
		c.Set("account_id", apiKey.Project().Account().ID)
		c.Set("project_id", apiKey.ProjectID)

		c.Next()
	}
}

type SignupRequest struct {
	Name     string `json:"name" binding:"required"`
	Email    string `json:"email" binding:"required,email"`
	Password string `json:"password" binding:"required,min=8"`
}

func signupHandler(dbClient *db.PrismaClient) gin.HandlerFunc {
	return func(c *gin.Context) {
		var req SignupRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}

		// In a real app, you would hash the password
		// For this example, we'll store it as-is.
		account, err := dbClient.Account.CreateOne(
			db.Account.Name.Set(req.Name),
			db.Account.Email.Set(req.Email),
			db.Account.Password.Set(req.Password), // Storing plaintext password - NOT FOR PRODUCTION
		).Exec(context.Background())

		if err != nil {
			log.Printf("Error creating account: %v", err)
			// Basic check for duplicate email
			if strings.Contains(err.Error(), "UniqueConstraintViolation") {
				c.JSON(http.StatusConflict, gin.H{"error": "Email already in use"})
				return
			}
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create account"})
			return
		}

		c.JSON(http.StatusCreated, gin.H{
			"message": "Account created successfully",
			"account": gin.H{
				"id":    account.ID,
				"name":  account.Name,
				"email": account.Email,
			},
		})
	}
}

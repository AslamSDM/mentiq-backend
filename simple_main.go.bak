	c.JSON(http.StatusOK, gin.H{
		"activeUsers": 42,
		"recentEvents": []map[string]interface{}{
			{
				"id":        uuid.New().String(),
				"type":      "page_view",
				"timestamp": time.Now().Format(time.RFC3339),
				"userId":    "user_123",
				"page":      "/dashboard",
			},
		},
	})
}
